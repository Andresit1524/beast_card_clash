{
    // Exclusiones de archivo
    "files.exclude": {
        "**/.godot/": true,
        "**/.builds/": true,
        "**/.doc_maker/": true,
    },
    "[gdscript]": {
        "editor.insertSpaces": false,
        "editor.detectIndentation": false,
        "editor.rulers": [
            100
        ],
        "editor.tabSize": 4,
        "editor.formatOnSave": true
    },
    "files.trimTrailingWhitespace": true,
    "files.insertFinalNewline": true
}
