[node name="CenterContainer" type="RichTextLabel" parent="Contents/Panel" unique_id=1701655034]
custom_minimum_size = Vector2(600, 0)
layout_mode = 2
bbcode_enabled = true
text = "[b]Beast Card Clash[/b] es un juego de cartas por turnos para 2 a 4 jugadores (por ahora, jugarás contra NPCs). El objetivo es ser el último en pie reduciendo la vida de tus rivales a 0.

Al inicio, cada jugador recibe 9 cartas aleatorias de 5 elementos (Fuego, Agua, Tierra, Aire, Energía) y 5 puntos de vida.
"
fit_content = true
autowrap_mode = 2
vertical_alignment = 1

[node name="Panel2" type="CenterContainer" parent="Contents" unique_id=1229561074]
visible = false
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2

[node name="CenterContainer" type="RichTextLabel" parent="Contents/Panel2" unique_id=516514529]
custom_minimum_size = Vector2(600, 0)
layout_mode = 2
bbcode_enabled = true
text = "En cada turno:

1. Lanzas el dado y te mueves en la Arena de batalla a la derecha o izquierda dependiendo el número que te salió.
2. La casilla donde caes determina qué elemento debes jugar.
3. Cada jugador elige una carta en secreto y se revelan al mismo tiempo.
4. Se comparan los elementos y los números (como dinámica de  piedra-papel-tijera)
5. Si un elemento gana, el perdedor pierde 1 vida
6. Si empatan, dependerá del número de la carta

Si aún así empatan, no pasa nada."
fit_content = true
autowrap_mode = 2
vertical_alignment = 1

