[node name="RichTextLabel" type="RichTextLabel" parent="Contents/Panel5" unique_id=1619883385]
custom_minimum_size = Vector2(500, 500)
layout_mode = 2
text = "Al final del turno, cada jugador vuelve a tener 9 cartas.

Pierdes 1 punto al perder el enfrentamiento con los otros jugadores. Ganas 1 punto al ganar en casillas Elemental o Clash.

Gana la partida quien sobreviva cuando todos los demás lleguen a 0.
"
